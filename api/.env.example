SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=isi-service-role-key
PORT=3000

# SUPABASE_KEY sebaiknya service role key karena RLS aktif dan API ini yang menangani tulis.
# Kunci ini hanya boleh ada di server, jangan pernah dipakai di PWA.
# Di Vercel, integrasi Supabase mengisi SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY otomatis,
# jadi SUPABASE_KEY tidak wajib ditambahkan di sana.
